{
  "extends": "@repo/typescript-config/base",
  "strict": true,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strictNullChecks": true
  },
  "include": ["src", "vite.config.ts"]
}
